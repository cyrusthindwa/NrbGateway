# Copy this file to .env and fill in real values before `docker compose up`.
# The .env file is gitignored — never commit real secrets.

# ── Postgres ───────────────────────────────────────────────────────────
POSTGRES_DB=chl_nrb_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ── MinIO ─────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=nrb-documents

# ── Exposed ports ─────────────────────────────────────────────────────
API_PORT=5050
FRONTEND_PORT=3000
MANUAL_PORTAL_PORT=3001

# ── Frontend (browser-facing API base URL, baked at build time) ───────
NEXT_PUBLIC_API_URL=http://localhost:5050

# ── NRB upstream credentials ──────────────────────────────────────────
NRB_BASE_URL=https://nrb-api-test.cict.gov.mw
NRB_TOKEN_ENDPOINT=https://nrb-api-test.cict.gov.mw/oauth/token
NRB_CLIENT_ID=chl_gateway_client_dev
NRB_CLIENT_SECRET=REPLACE_WITH_SECRETS_STORE_IN_PRODUCTION
NRB_TEXT_LOOKUP_CLIENT_ID=chl_gateway_text_lookup_dev
NRB_TEXT_LOOKUP_CLIENT_KEY=REPLACE_WITH_SECRETS_STORE_IN_PRODUCTION
NRB_SIMULATION_MODE=false

# ── JWT ───────────────────────────────────────────────────────────────
JWT_ISSUER=CHL_NRB_Gateway
JWT_AUDIENCE=CHL_Portal_Admins
JWT_SECRET_KEY=REPLACE_WITH_SECRETS_STORE_IN_PRODUCTION_MIN_256_BITS

# ── Encryption ────────────────────────────────────────────────────────
ENCRYPTION_HMAC_KEY=REPLACE_WITH_SECRETS_STORE_IN_PRODUCTION
ENCRYPTION_PGP_KEY=REPLACE_WITH_SECRETS_STORE_IN_PRODUCTION

# ── M365 2FA (Microsoft Graph, OAuth 2.0 client-credentials) ──────────
# Requires an app registration in CHL's Entra ID tenant with the Mail.Send
# application permission, granted admin consent. SMTP AUTH basic auth was
# retired by Microsoft on 2026-03-01, so email goes through the Graph API.
# Leave blank unless using Microsoft Graph for mail delivery.
M365_TENANT_ID=REPLACE_WITH_TENANT_ID
M365_CLIENT_ID=REPLACE_WITH_CLIENT_ID
M365_CLIENT_SECRET=REPLACE_WITH_SECRETS_STORE_IN_PRODUCTION
M365_SENDER_ADDRESS=noreply@continental.mw

# ── Admin OTP (two-factor) ────────────────────────────────────────────
OTP_CODE_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Portal ────────────────────────────────────────────────────────────
# Base URL of the admin console, used to build links emailed to admins.
PORTAL_BASE_URL=http://localhost:3000

# Base URL of the Manual Verification Portal, used to build password-reset
# links emailed to manual portal users.
MANUAL_PORTAL_BASE_URL=http://localhost:3001

# ── Email (SMTP) ──────────────────────────────────────────────────────
# Outbound mail for OTP codes, password resets and admin notifications.
# smtp.office365.com requires SMTP AUTH enabled on the mailbox (or an app password).
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=itsupport@continental.mw
MAIL_PASSWORD=REPLACE_WITH_SECRETS_STORE_IN_PRODUCTION
MAIL_FROM_ADDRESS=itsupport@continental.mw
MAIL_FROM_NAME=NRB Gateway Console
